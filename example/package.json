{
  "name": "example",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "generate-licenses": "node scripts/generate-licenses.js",
    "check:linkage": "node scripts/check-library-linkage.js",
    "e2e:ios": "node e2e/run.mjs --platform ios --session ipadlive",
    "e2e:android": "node e2e/run.mjs --platform android --session pix"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.4",
    "expo-blur": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-dl-scan": "portal:..",
    "react-native-fast-tflite": "^3.0.0",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.0.11",
    "react-native-vision-camera-barcode-scanner": "5.0.11",
    "react-native-vision-camera-worklets": "5.1.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "postcss": "^8.5.10",
    "ws": "^8",
    "uuid": "^11",
    "shell-quote": "^1.10.0"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-vision-camera-barcode-scanner"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-fast-tflite",
          "react-native-nitro-image",
          "react-native-dl-scan"
        ]
      }
    }
  }
}
