# ---------------------------------------------------------------------------
# Optional test identity overrides.
#
# The test suites ship with fully FICTIONAL identity values, so they pass with
# no setup. To validate parsing against a REAL driver's license locally, copy
# this file to .env (which is gitignored) and fill in your own card's values:
#
#   cp .env.example .env       # then edit .env with your values
#   set -a; . ./.env; set +a   # export them for the test process
#   yarn test:cpp              # and/or the Android JVM tests
#
# NEVER commit real values. .env is gitignored for exactly this reason.
# ---------------------------------------------------------------------------

# Date of birth — as printed (US MM/DD/YYYY) and ISO-normalized.
DLSCAN_TEST_DOB_SLASH=01/02/1990
DLSCAN_TEST_DOB_ISO=1990-01-02

# Driver-license number — full clean read and the clipped 3-4-4 fragment.
DLSCAN_TEST_DLN_FULL=P135-2468-1357-09
DLSCAN_TEST_DLN_CLIPPED=135-2468-1357
